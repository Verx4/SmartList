# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend
APP_NAME=Engenharia Slides API
ENVIRONMENT=development
SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=false
DATABASE_URL=postgresql+psycopg://engenharia:engenharia@localhost:5432/engenharia_slides
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Armazenamento privado: local no MVP, S3 compatível em produção
STORAGE_BACKEND=local
PRIVATE_STORAGE_PATH=./private_storage
MAX_FILE_SIZE_MB=250
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Integração futura — mantenha vazia enquanto não houver API oficial
PREVISION_BASE_URL=
INTEGRATION_ENCRYPTION_KEY=

# PostgreSQL do Docker Compose
POSTGRES_DB=engenharia_slides
POSTGRES_USER=engenharia
POSTGRES_PASSWORD=engenharia
